# Copy to `.env` (used by docker compose) and/or `.env.local` (loaded by `pnpm desktop:dev`).
# Never commit real secrets. See docs/agent-memory.md.

# --- AgentMemory (persistent memory for development agents) ---------------
# Master switch for the in-app MemoryProvider. false → NoopMemoryProvider.
AGENTMEMORY_ENABLED=false

# Where the AgentMemory server listens (docker-compose.agentmemory.yml publishes 3111 on loopback).
AGENTMEMORY_URL=http://localhost:3111

# Bearer secret. Leave empty to let the container generate one on first boot
# (it is printed once in `pnpm memory:logs`). Required by every client once set.
AGENTMEMORY_SECRET=

# Canonical project id sent as AgentMemory's `project`. Defaults to the repository folder name.
AGENTMEMORY_PROJECT=kodra

# Team memory. The server enables team sharing only when both are set (mapped to TEAM_ID/USER_ID).
AGENTMEMORY_TEAM_ID=kodra
AGENTMEMORY_USER_ID=

# Which agent is writing (mapped to AGENT_ID / per-request agentId): opencode, claude-code, kodra, ...
AGENTMEMORY_AGENT_ID=opencode

# private (default): memories stay personal until explicitly shared. shared: server-side TEAM_MODE=shared.
AGENTMEMORY_MODE=private

# Optional tuning
AGENTMEMORY_TIMEOUT_MS=2000
AGENTMEMORY_MAX_CONTEXT_ITEMS=10
AGENTMEMORY_MAX_CONTEXT_CHARS=8000
# AGENTMEMORY_HEALTH_CACHE_MS=30000
# AGENTMEMORY_PORT=3111
