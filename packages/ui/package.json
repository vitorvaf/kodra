{
  "name": "@kanbots/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Kodra renderer UI kit: theme and dashboard layout adapted from the Able Pro MUI template (licensed; not for publication)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-augmentation.cjs",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/lab": "5.0.0-alpha.177",
    "@mui/material": "^5.18.0",
    "@mui/system": "^5.18.0",
    "iconsax-react": "^0.0.8",
    "lodash": "^4.18.1",
    "react-device-detect": "^2.2.3",
    "simplebar": "^6.3.3",
    "simplebar-react": "^3.3.2"
  }
}
